# Contoh variabel lingkungan API Dokter HP Web.
# Salin ke .dev.vars untuk pengembangan lokal (`wrangler dev` membaca
# .dev.vars; JANGAN commit .dev.vars — file itu berisi secret lokal).
# Produksi: variabel non-rahasia di [vars] wrangler.toml; secret lewat
# `wrangler secret put` (lihat docs/deploy.md §6.2).
#
# PERINGATAN: nilai di bawah ini hanya PLACEHOLDER. Jangan memakai
# nilai dummy di produksi, terutama PIN_PEPPER.

# Asal frontend yang diizinkan CORS (dipisah koma bila lebih dari satu).
ALLOWED_ORIGIN=https://dokter-hp-web.pages.dev
# Asal frontend untuk redirect setelah masuk Google.
FRONTEND_URL=https://dokter-hp-web.pages.dev

# Google OAuth (secret di produksi).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dokter-hp-api.contoh.workers.dev/api/auth/google/callback

# Diagnosis AI (GEMINI_API_KEY secret di produksi).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Pepper HMAC-SHA256 untuk hash PIN (secret di produksi; WAJIB diisi —
# endpoint PIN gagal tertutup 500 bila kosong). Nilai dummy lokal:
PIN_PEPPER=dummy-lokal-bukan-rahasia
